小红书搜索页 = type=http-response, pattern=^https?:\/\/(so|edith)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/notes\?, script-path=https://github.com/fmz200/wool_scripts/raw/009b501adaebb3428461e91c98a17a556249e076/Scripts/xiaohongshu/xiaohongshu.js, requires-body=true, timeout=10

