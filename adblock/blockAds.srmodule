#!name=广告拦截(自用白名单版)
#!desc=基于 fmz200/blockAds 裁剪：仅对 69 款自用 App 做 MITM 去广告，已剔除金融类（雪球/同花顺/天天基金除外）；其余 App 仅 DNS 层拦截
#!author=奶思[https://github.com/fmz200]
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/AdblockPlus.png
#!category=奶思的模块
#!homepage=https://github.com/chaojiman/sr-rules
#!raw-url=https://github.com/chaojiman/sr-rules/raw/main/adblock/blockAds.srmodule
#!tg-channel=https://t.me/inaisi
#!tag=去广告, fmz200, 奶思
#!system=ios
#!date=2026-11-11 22:01:38
#!remark=下方的所有规则都标注了对应的hostname，可能存在错误或者遗漏，欢迎反馈。对于无法/可选MITM的hostname都特别做了“如开启可自行添加主机名”提示，如果提示后面没有标注主机名则包含所有主机名，否则只包含提示语后面的主机名。
#!arguments=12306_enable:true


# >>>>>>>>>>>>>>> 🟣 <<<<<<<<<<<<<<
[Rule]
# > QUIC 拦截（sr-rules 追加：直连 App 回退 TCP，MITM 才能生效）
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,amemv.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,snssdk.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,taobao.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,cainiao.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,goofish.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,zhihu.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,pinduoduo.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,yangkeduo.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,bilibili.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,biliapi.net)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,hongyibo.com.cn)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com)),REJECT

URL-REGEX,"^http:\/\/p\d+-be-pack-sign\.pglstatp-toutiao\.com\/(ad-app-package|web\.business\.image)\/",REJECT
URL-REGEX,"^https:\/\/a\.line\.me\/lass\/api\/v\d\/ads$",REJECT-DROP
URL-REGEX,"^https:\/\/a\.line\.me\/oa\/v\d\/e$",REJECT-DROP
URL-REGEX,"^https:\/\/a\.line\.me\/cs\/v\d\/oa$",REJECT-DROP
URL-REGEX,"^https:\/\/w\.line\.me\/adp\/api\/ad\/v\d\/",REJECT-DROP
URL-REGEX,"^https:\/\/crs-event\.line\.me\/v\d\/imp",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/0h.+\/(o|m)\d+x\d+$",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/0hGH\d",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/0h.+\/\d+p\.mp4$",REJECT-DROP
URL-REGEX,"^https:\/\/scdn\.line-apps\.com\/lan\/image\/line\/bannerImageEvent\/",REJECT-DROP
URL-REGEX,"^https:\/\/scdn\.line-apps\.com\/lan\/document\/pageEvent\/line\/ios\/",REJECT-DROP
URL-REGEX,"^https:\/\/sch\.line\.me\/api\/v\d\/ads$",REJECT-DROP
URL-REGEX,"^https:\/\/uts-front\.line-apps\.com\/event$",REJECT-DROP
URL-REGEX,"^https:\/\/uts-front\.line-apps\.com\/settings$",REJECT-DROP
URL-REGEX,"^http:\/\/p\d+-be-pack-sign\.pglstatp-toutiao\.com\/(ad-app-package|web\.business\.image)\/",REJECT
AND,((URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch"),(USER-AGENT,"%E9%97%B2%E9%B1%BC*")),REJECT
USER-AGENT,"AVOS*",REJECT
[Header Rewrite]
# >>>>>>>>>>>>>>> ✅ !! ✅ <<<<<<<<<<<<<<



# >>>>>>>>>>>>>>> ✅ 1 ✅ <<<<<<<<<<<<<<



# >>>>>>>>>>>>>>> ✅ 2 ✅ <<<<<<<<<<<<<<



# >>>>>>>>>>>>>>> ✅ 3 ✅ <<<<<<<<<<<<<<



# >>>>>>>>>>>>>>> ✅ 5 ✅ <<<<<<<<<<<<<<



# >>>>>>>>>>>>>>> ✅ A ✅ <<<<<<<<<<<<<<



# >>>>>>>>>>>>>>> ✅ B ✅ <<<<<<<<<<<<<<
# > 哔哩哔哩
# hostname = grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(interface\.v1\.(Teenagers\/ModeStatus|Search\/DefaultWords)|view\.v1\.View\/TFInfo|viewunite\.v1\.View\/ViewEndPage)$ header-add 'grpc-status' '0'


